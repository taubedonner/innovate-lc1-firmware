    <symbol name="USART0_RXC"   address="code:0x0024" entry="true"/>
    <symbol name="USART0_UDRE"  address="code:0x0026" entry="true"/>
    <symbol name="USART0_TXC"   address="code:0x0028" entry="true"/>
    <symbol name="ADC"          address="code:0x002A" entry="true"/>
    <symbol name="EE_RDY"       address="code:0x002C" entry="true"/>
    <symbol name="ANA_COMP"     address="code:0x002E" entry="true"/>
    <symbol name="TIMER1_COMPC" address="code:0x0030" entry="true"/>
    <symbol name="TIMER3_CAPT"  address="code:0x0032" entry="true"/>
    <symbol name="TIMER3_COMPA" address="code:0x0034" entry="true"/>
    <symbol name="TIMER3_COMPB" address="code:0x0036" entry="true"/>
    <symbol name="TIMER3_COMPC" address="code:0x0038" entry="true"/>
    <symbol name="TIMER3_OVF"   address="code:0x003A" entry="true"/>
    <symbol name="USART1_RXC"   address="code:0x003C" entry="true"/>
    <symbol name="USART1_UDRE"  address="code:0x003E" entry="true"/>
    <symbol name="USART1_TXC"   address="code:0x0040" entry="true"/>
    <symbol name="TWI"          address="code:0x0042" entry="true"/>
    <symbol name="SPM_RDY"      address="code:0x0044" entry="true"/>

    <!-- Atmega64A datasheet-->
    <symbol name="PINF"   address="mem:0x20"/>
    <symbol name="PINE"   address="mem:0x21"/>
    <symbol name="DDRE"   address="mem:0x22"/>
    <symbol name="PORTE"  address="mem:0x23"/>
    <symbol name="ADCL"   address="mem:0x24"/>
    <symbol name="ADCH"   address="mem:0x25"/>
